#!/bin/bash
#SBATCH -J par_1x16
#SBATCH -N 1
#SBATCH --ntasks-per-node=16
#SBATCH --exclusive
#SBATCH --no-requeue
#SBATCH --export=ALL
#SBATCH -t 01:00:00
#SBATCH -o %x.%j.out

echo "Início: $(date)"
echo "Job:    $SLURM_JOB_ID"
echo "Nós:    $SLURM_JOB_NODELIST"

for r in $(seq 1 10); do
  echo "== Repetição $r"
  mpirun -np 16 $SLURM_SUBMIT_DIR/paralelo/paralelo -n 5000
done

echo "Fim:    $(date)"
